# LexPilot Configuration Example
# Copy this file to .env and insert your API keys if running in live cloud mode.
# If no key is set, LexPilot runs with its built-in offline verified legal reasoning engine.

GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Google Document AI credentials path (if configured)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# DOCAI_PROCESSOR_ID=your_processor_id_here

# Server host & port
HOST=127.0.0.1
PORT=8000
